#include <WiFi.h>
#include <DNSServer.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// Built-in LED Pin
#define LED_PIN 2

// WiFi Hotspot Configuration
const char *ssid = "ArmoNex Robot";
const char *password = "12345678";

// DNS and Web Server
const byte DNS_PORT = 53;
IPAddress apIP(192, 168, 4, 1);
DNSServer dnsServer;
WebServer server(80);

// Servo Setup (7 Axis)
#define NUM_SERVOS 7
Servo servos[NUM_SERVOS];

// ESP32 GPIO Pins for 7 Servos
const int servoPins[NUM_SERVOS] = {13, 12, 14, 27, 26, 25, 33};

// Current Target & Actual Angles
float currentAngles[NUM_SERVOS] = {90, 90, 90, 90, 90, 90, 90};
float targetAngles[NUM_SERVOS]  = {90, 90, 90, 90, 90, 90, 90};
int homeAngles[NUM_SERVOS]      = {90, 90, 90, 90, 90, 90, 90};

// Axis Names
const char* axisNames[NUM_SERVOS] = {
  "1. Base",
  "2. Shoulder",
  "3. Elbow",
  "4. Wrist Pitch",
  "5. Wrist Roll",
  "6. Gripper Rotate",
  "7. Gripper"
};

#define MAX_STEPS 50
int recordedSteps[MAX_STEPS][NUM_SERVOS];
int stepCount = 0;

// Playback State Control
enum PlayMode { STOPPED, PLAY_ONCE, PLAY_LOOP };
PlayMode currentMode = STOPPED;

// মেমরি লক করার জন্য ফ্ল্যাগ (প্লে ব্যাক চালু হলেই এটি true হবে)
bool isMemoryLocked = false; 

unsigned long lastStepTime = 0;
int currentPlaybackStep = 0;
const int stepHoldTime = 500; // Stay time at recorded position (ms)

// Smooth Controlled Speed
const float SERVO_SPEED = 1.0; 

// HTML Web Page Interface
const char HTML_CONTENT[] PROGMEM = R"rawliteral(
